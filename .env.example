# 本地开发用环境变量模板
# 复制成 .env 并填入真值（.env 已在 .gitignore 里，不会被提交）
#
# 线上运行不需要这个文件——线上用 GitHub Secrets / SCF 环境变量。

# ── 必填 ──────────────────────────────────────────────

# LLM API Key。任何兼容 OpenAI 接口的服务都可以
LLM_API_KEY=replace-me

# 飞书自建应用凭证（飞书开放平台 → 你的应用 → 凭证与基础信息）
FEISHU_APP_ID=cli_replace-me
FEISHU_APP_SECRET=replace-me

# 飞书群 chat_id，形如 oc_xxxxxxxxxxxx
FEISHU_CHAT_ID=oc_replace-me

# ── 可选：切换 LLM 服务商 ──────────────────────────────

# 默认 DeepSeek。换 Kimi / 智谱 / OpenAI 时改这两个
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 智谱 GLM 示例：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus

# Kimi 示例：
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-32k

# ── 本地调试 ──────────────────────────────────────────

# 不真正写文件 / 不真正发飞书，只打印将要执行的动作
# DRY_RUN=1

# 覆盖数据根目录（默认是仓库根）
# DAILY_ROOT=/path/to/repo
